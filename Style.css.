* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #0b0f14;
  color: #f4f7fb;
}

.topbar {
  min-height: 72px;
  padding: 16px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #202833;
  background: #0e141c;
}

.brand {
  font-size: 25px;
  font-weight: 800;
}

.subtitle {
  margin-top: 3px;
  color: #8995a5;
  font-size: 13px;
}

.demo-badge {
  padding: 8px 12px;
  border: 1px solid #765b18;
  border-radius: 8px;
  background: #211b0d;
  color: #ffd65a;
  font-size: 12px;
  font-weight: 700;
}

.container {
  width: min(1400px, 92%);
  margin: 28px auto;
}

.account-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 18px;
}

.card {
  background: #111821;
  border: 1px solid #202a36;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.18);
}

.card span {
  color: #8995a5;
  font-size: 13px;
}

.card strong {
  display: block;
  margin-top: 8px;
  font-size: 23px;
}

.trading-layout {
  display: grid;
  grid-template-columns: 1fr 330px;
  gap: 18px;
  margin-bottom: 18px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

h2 {
  margin: 0;
  font-size: 18px;
}

.price {
  margin-top: 7px;
  font-size: 28px;
  font-weight: 800;
}

select,
input {
  width: 100%;
  padding: 12px;
  border: 1px solid #303b49;
  border-radius: 8px;
  background: #0b1017;
  color: white;
  outline: none;
}

select {
  width: 150px;
}

input:focus,
select:focus {
  border-color: #607080;
}

#chart {
  width: 100%;
  height: 360px;
  display: block;
  margin-top: 18px;
  background: #0c1219;
  border-radius: 8px;
}

.notice {
  color: #7f8b9a;
  font-size: 12px;
  margin-bottom: 0;
}

.order-card label {
  display: block;
  margin: 22px 0 8px;
  color: #aab4c1;
  font-size: 13px;
}

.quick-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin-top: 8px;
}

button {
  border: 0;
  border-radius: 8px;
  padding: 11px;
  cursor: pointer;
  font-weight: 700;
  color: white;
  background: #27313d;
}

button:hover {
  filter: brightness(1.15);
}

.order-info {
  margin-top: 20px;
  padding: 14px;
  border-radius: 8px;
  background: #0c1219;
}

.order-info div {
  display: flex;
  justify-content: space-between;
  margin: 8px 0;
}

.order-info strong {
  margin: 0;
  font-size: 14px;
}

.trade-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 18px;
}

.buy {
  background: #168454;
}

.sell {
  background: #b6414d;
}

.reset {
  width: 100%;
  margin-top: 12px;
  background: transparent;
  border: 1px solid #394553;
  color: #aeb8c4;
}

.small-button {
  padding: 7px 10px;
  font-size: 12px;
}

.table-wrapper {
  overflow-x: auto;
  margin-top: 18px;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

th,
td {
  padding: 13px 10px;
  border-bottom: 1px solid #202a36;
  text-align: left;
  font-size: 13px;
}

th {
  color: #7f8b9a;
  font-weight: 600;
}

.empty {
  text-align: center;
  color: #657181;
  padding: 28px;
}

footer {
  text-align: center;
  color: #687586;
  font-size: 12px;
  padding: 30px 0;
}

@media (max-width: 900px) {
  .account-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .trading-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .topbar {
    align-items: flex-start;
    gap: 12px;
    flex-direction: column;
  }

  .account-grid {
    grid-template-columns: 1fr;
  }

  .container {
    width: 94%;
  }

  #chart {
    height: 280px;
  }

  .section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  select {
    width: 100%;
  }
}
