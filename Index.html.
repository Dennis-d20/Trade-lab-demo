<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TradeLab — Demo Trading</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <div>
      <div class="brand">TradeLab</div>
      <div class="subtitle">Paper Trading Simulator</div>
    </div>

    <div class="demo-badge">DEMO • NO REAL MONEY</div>
  </header>

  <main class="container">
    <section class="account-grid">
      <div class="card">
        <span>Balance</span>
        <strong id="balance">$10,000.00</strong>
      </div>

      <div class="card">
        <span>Equity</span>
        <strong id="equity">$10,000.00</strong>
      </div>

      <div class="card">
        <span>Unrealized P&L</span>
        <strong id="pnl">$0.00</strong>
      </div>

      <div class="card">
        <span>Open Positions</span>
        <strong id="positionCount">0</strong>
      </div>
    </section>

    <section class="trading-layout">
      <div class="card chart-card">
        <div class="section-header">
          <div>
            <h2 id="marketName">BTC/USD</h2>
            <div class="price" id="currentPrice">$67,420.00</div>
          </div>

          <select id="marketSelect">
            <option value="BTCUSD">BTC/USD</option>
            <option value="ETHUSD">ETH/USD</option>
            <option value="SOLUSD">SOL/USD</option>
            <option value="EURUSD">EUR/USD</option>
          </select>
        </div>

        <canvas id="chart"></canvas>

        <p class="notice">
          Simulated prices only. This is not live market data.
        </p>
      </div>

      <div class="card order-card">
        <h2>Place Demo Order</h2>

        <label for="amount">Amount (USD)</label>
        <input
          id="amount"
          type="number"
          min="1"
          step="1"
          value="100"
        />

        <div class="quick-buttons">
          <button data-amount="50">$50</button>
          <button data-amount="100">$100</button>
          <button data-amount="250">$250</button>
          <button data-amount="500">$500</button>
        </div>

        <div class="order-info">
          <div>
            <span>Demo fee</span>
            <strong id="fee">$0.10</strong>
          </div>

          <div>
            <span>Market price</span>
            <strong id="orderPrice">$67,420.00</strong>
          </div>
        </div>

        <div class="trade-buttons">
          <button id="buyBtn" class="buy">BUY</button>
          <button id="sellBtn" class="sell">SELL</button>
        </div>

        <button id="resetBtn" class="reset">
          Reset Demo Account
        </button>
      </div>
    </section>

    <section class="card">
      <div class="section-header">
        <h2>Open Positions</h2>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Market</th>
              <th>Side</th>
              <th>Amount</th>
              <th>Entry</th>
              <th>Current</th>
              <th>P&L</th>
              <th></th>
            </tr>
          </thead>

          <tbody id="positionsBody">
            <tr>
              <td colspan="7" class="empty">
                No open positions
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="section-header">
        <h2>Trade History</h2>
        <button id="clearHistory" class="small-button">
          Clear History
        </button>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Market</th>
              <th>Action</th>
              <th>Amount</th>
              <th>Price</th>
            </tr>
          </thead>

          <tbody id="historyBody">
            <tr>
              <td colspan="5" class="empty">
                No trades yet
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <footer>
      TradeLab is a fictional paper-trading simulator.
      No real money, deposits, withdrawals, or brokerage services are provided.
    </footer>
  </main>

  <script src="/app.js"></script>
</body>
</html>
