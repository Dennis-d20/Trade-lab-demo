const startingBalance = 10000;
const feeRate = 0.001;

const markets = {
  BTCUSD: { name: "BTC/USD", price: 67420 },
  ETHUSD: { name: "ETH/USD", price: 3520 },
  SOLUSD: { name: "SOL/USD", price: 154 },
  EURUSD: { name: "EUR/USD", price: 1.172 }
};

let state = JSON.parse(localStorage.getItem("tradelab")) || {
  balance: startingBalance,
  positions: [],
  history: []
};

let selectedMarket = "BTCUSD";
let prices = {};
let chartData = {};

Object.keys(markets).forEach((key) => {
  prices[key] = markets[key].price;

  chartData[key] = Array.from(
    { length: 40 },
    () => markets[key].price * (0.995 + Math.random() * 0.01)
  );
});

const balanceEl = document.getElementById("balance");
const equityEl = document.getElementById("equity");
const pnlEl = document.getElementById("pnl");
const positionCountEl = document.getElementById("positionCount");

const marketNameEl = document.getElementById("marketName");
const currentPriceEl = document.getElementById("currentPrice");
const orderPriceEl = document.getElementById("orderPrice");
const marketSelect = document.getElementById("marketSelect");
const amountInput = document.getElementById("amount");
const feeEl = document.getElementById("fee");

const positionsBody = document.getElementById("positionsBody");
const historyBody = document.getElementById("historyBody");

const buyBtn = document.getElementById("buyBtn");
const sellBtn = document.getElementById("sellBtn");
const resetBtn = document.getElementById("resetBtn");
const clearHistoryBtn = document.getElementById("clearHistory");

const chart = document.getElementById("chart");
const ctx = chart.getContext("2d");

function saveState() {
  localStorage.setItem("tradelab", JSON.stringify(state));
}

function money(value) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(value);
}

function formatPrice(value) {
  if (value < 10) {
    return value.toFixed(4);
  }

  if (value < 1000) {
    return value.toFixed(2);
  }

  return value.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
}

function calculatePositionPnl(position) {
  const current = prices[position.market];

  if (position.side === "BUY") {
    return position.amount * ((current - position.entry) / position.entry);
  }

  return position.amount * ((position.entry - current) / position.entry);
}

function totalUnrealizedPnl() {
  return state.positions.reduce(
    (total, position) => total + calculatePositionPnl(position),
    0
  );
}

function renderAccount() {
  const pnl = totalUnrealizedPnl();
  const equity = state.balance + pnl;

  balanceEl.textContent = money(state.balance);
  equityEl.textContent = money(equity);
  pnlEl.textContent = money(pnl);
  positionCountEl.textContent = state.positions.length;
}

function renderMarket() {
  const market = markets[selectedMarket];
  const price = prices[selectedMarket];

  marketNameEl.textContent = market.name;
  currentPriceEl.textContent = "$" + formatPrice(price);
  orderPriceEl.textContent = "$" + formatPrice(price);

  const amount = Number(amountInput.value) || 0;
  feeEl.textContent = money(amount * feeRate);
}

function renderPositions() {
  if (state.positions.length === 0) {
    positionsBody.innerHTML = `
      <tr>
        <td colspan="7" class="empty">No open positions</td>
      </tr>
    `;
    return;
  }

  positionsBody.innerHTML = state.positions
    .map((position) => {
      const pnl = calculatePositionPnl(position);

      return `
        <tr>
          <td>${markets[position.market].name}</td>
          <td>${position.side}</td>
          <td>${money(position.amount)}</td>
          <td>$${formatPrice(position.entry)}</td>
          <td>$${formatPrice(prices[position.market])}</td>
          <td>${money(pnl)}</td>
          <td>
            <button onclick="closePosition('${position.id}')">
              Close
            </button>
          </td>
        </tr>
      `;
    })
    .join("");
}

function renderHistory() {
  if (state.history.length === 0) {
    historyBody.innerHTML = `
      <tr>
        <td colspan="5" class="empty">No trades yet</td>
      </tr>
    `;
    return;
  }

  historyBody.innerHTML = state.history
    .slice()
    .reverse()
    .map((trade) => {
      return `
        <tr>
          <td>${trade.time}</td>
          <td>${markets[trade.market].name}</td>
          <td>${trade.action}</td>
          <td>${money(trade.amount)}</td>
          <td>$${formatPrice(trade.price)}</td>
        </tr>
      `;
    })
    .join("");
}

function renderAll() {
  renderAccount();
  renderMarket();
  renderPositions();
  renderHistory();
  drawChart();
}

function placeOrder(side) {
  const amount = Number(amountInput.value);

  if (!amount || amount <= 0) {
    alert("Enter a valid demo amount.");
    return;
  }

  const fee = amount * feeRate;
  const totalCost = amount + fee;

  if (side === "BUY" && totalCost > state.balance) {
    alert("Insufficient demo balance.");
    return;
  }

  if (side === "BUY") {
    state.balance -= totalCost;
  }

  if (side === "SELL") {
    state.balance += amount - fee;
  }

  const position = {
    id: Date.now().toString(),
    market: selectedMarket,
    side,
    amount,
    entry: prices[selectedMarket],
    openedAt: new Date().toLocaleTimeString()
  };

  state.positions.push(position);

  state.history.push({
    time: new Date().toLocaleString(),
    market: selectedMarket,
    action: side,
    amount,
    price: prices[selectedMarket]
  });

  saveState();
  renderAll();
}

function closePosition(id) {
  const index = state.positions.findIndex(
    (position) => position.id === id
  );

  if (index === -1) {
    return;
  }

  const position = state.positions[index];
  const pnl = calculatePositionPnl(position);
  const fee = position.amount * feeRate;

  if (position.side === "BUY") {
    state.balance += position.amount + pnl - fee;
  } else {
    state.balance -= pnl + fee;
  }

  state.positions.splice(index, 1);

  state.history.push({
    time: new Date().toLocaleString(),
    market: position.market,
    action: "CLOSE " + position.side,
    amount: position.amount,
    price: prices[position.market]
  });

  saveState();
  renderAll();
}

window.closePosition = closePosition;

function resetAccount() {
  const confirmed = confirm(
    "Reset the demo account and delete all positions and history?"
  );

  if (!confirmed) {
    return;
  }

  state = {
    balance: startingBalance,
    positions: [],
    history: []
  };

  saveState();
  renderAll();
}

function clearHistory() {
  state.history = [];
  saveState();
  renderHistory();
}

function resizeCanvas() {
  const rect = chart.getBoundingClientRect();

  const ratio = window.devicePixelRatio || 1;

  chart.width = rect.width * ratio;
  chart.height = rect.height * ratio;

  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

  drawChart();
}

function drawChart() {
  const rect = chart.getBoundingClientRect();
  const width = rect.width;
  const height = rect.height;

  if (!width || !height) {
    return;
  }

  ctx.clearRect(0, 0, width, height);

  const data = chartData[selectedMarket];

  if (!data || data.length < 2) {
    return;
  }

  const min = Math.min(...data);
  const max = Math.max(...data);
  const range = max - min || 1;

  ctx.beginPath();

  data.forEach((value, index) => {
    const x = (index / (data.length - 1)) * width;
    const y =
      height -
      ((value - min) / range) * (height - 30) -
      15;

    if (index === 0) {
      ctx.moveTo(x, y);
    } else {
      ctx.lineTo(x, y);
    }
  });

  ctx.strokeStyle = "#55c2ff";
  ctx.lineWidth = 2;
  ctx.stroke();

  ctx.font = "12px Arial";
  ctx.fillStyle = "#8995a5";

  ctx.fillText(
    "$" + formatPrice(max),
    10,
    18
  );

  ctx.fillText(
    "$" + formatPrice(min),
    10,
    height - 8
  );
}

function updatePrices() {
  Object.keys(prices).forEach((key) => {
    const current = prices[key];

    const movement =
      current *
      (Math.random() - 0.5) *
      0.002;

    prices[key] = Math.max(
      current + movement,
      0.0001
    );

    chartData[key].push(prices[key]);

    if (chartData[key].length > 40) {
      chartData[key].shift();
    }
  });

  renderAll();
}

marketSelect.addEventListener("change", (event) => {
  selectedMarket = event.target.value;
  renderAll();
});

amountInput.addEventListener("input", renderMarket);

document.querySelectorAll("[data-amount]").forEach((button) => {
  button.addEventListener("click", () => {
    amountInput.value = button.dataset.amount;
    renderMarket();
  });
});

buyBtn.addEventListener("click", () => {
  placeOrder("BUY");
});

sellBtn.addEventListener("click", () => {
  placeOrder("SELL");
});

resetBtn.addEventListener("click", resetAccount);

clearHistoryBtn.addEventListener("click", clearHistory);

window.addEventListener("resize", resizeCanvas);

renderAll();
resizeCanvas();

setInterval(updatePrices, 1400);
